# ── Jina usage tracking ───────────────────────────────────────────────────────
# Jina free balance: ~10M tokens. Each s.jina.ai search costs ~10k tokens.
# ~1,000 searches before exhaustion. We track locally since Jina has no public
# balance API. Warn the maintainer at 80% usage (~800 searches).

JINA_USAGE_FILE = CACHE_DIR / "jina_usage.json"
JINA_FREE_BUDGET = 1_000   # conservative search count before balance runs out
JINA_WARN_AT    = 800      # warn when this many searches have been used

def _record_jina_usage(n: int = 1):
    try:
        data = json.loads(JINA_USAGE_FILE.read_text()) if JINA_USAGE_FILE.exists() else {}
        data["searches_used"] = data.get("searches_used", 0) + n
        data["last_updated"]  = datetime.now(timezone.utc).isoformat()
        JINA_USAGE_FILE.parent.mkdir(parents=True, exist_ok=True)
        JINA_USAGE_FILE.write_text(json.dumps(data, indent=2))
    except Exception:
        pass

def jina_usage_stats() -> dict:
    try:
        if JINA_USAGE_FILE.exists():
            return json.loads(JINA_USAGE_FILE.read_text())
    except Exception:
        pass
    return {"searches_used": 0}

def jina_balance_warning() -> str | None:
    stats = jina_usage_stats()
    used = stats.get("searches_used", 0)
    if used >= JINA_FREE_BUDGET:
        return f"⚠  JINA BALANCE LIKELY EXHAUSTED ({used}/{JINA_FREE_BUDGET} searches used). Get a new key at https://jina.ai"
    if used >= JINA_WARN_AT:
        remaining = JINA_FREE_BUDGET - used
        return f"⚠  JINA BALANCE LOW: ~{remaining} searches remaining. Consider renewing at https://jina.ai"
    return None

